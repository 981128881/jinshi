# ============================================================
# 商超项目 · 阿里云生产环境（唯一配置源）
# 部署前：把 your-domain.com 改成你的备案域名，并修改所有 CHANGE_ME
# 一键写入各项目：node deploy/apply-production-env.mjs --domain=你的域名.com
# ============================================================

# --- 域名（必须修改）---
PRODUCTION_DOMAIN=your-domain.com

# 子域名约定（需 DNS 解析 + ICP 备案 + SSL）
# API:   https://api.your-domain.com
# 管理:  https://admin.your-domain.com

# --- 后端 wxapp-backend ---
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://api.your-domain.com

JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

DATABASE_URL=mysql://wxapp:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/wxapp_shop?connection_limit=10&pool_timeout=20
REDIS_URL=redis://127.0.0.1:6379

REQUEST_TIMEOUT_MS=30000
LOG_DIR=./logs
LOG_LEVEL=info
LOG_TO_CONSOLE=false
LOG_MAX_FILE_MB=50
DB_LOG_QUERY=false
DB_SLOW_QUERY_MS=1000
REDIS_LOG_CACHE=false
CLIENT_LOG_ENABLED=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_ACCESS_EXPIRES_IN=2h
ADMIN_REFRESH_EXPIRES_IN=7d

POS_SYNC_TOKEN=CHANGE_ME_POS_SYNC_TOKEN

# 微信小程序（上线必填）
WX_APPID=
WX_SECRET=
WX_MOCK=false

# 微信支付（开通后填写）
WX_MCH_ID=
WX_API_V3_KEY=
WX_CERT_SERIAL_NO=
WX_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_MERCHANT_CERT_PATH=./certs/apiclient_cert.pem
WX_PAY_NOTIFY_URL=https://api.your-domain.com/api/pay/notify
WX_PAY_MOCK=false
ORDER_PAY_TIMEOUT_MINUTES=15

# 可选
APIZERO_API_KEY=
JISU_API_KEY=
TENCENT_MAP_KEY=

# 服务器上 POS 图片路径（若 POS 不同步到云，可留空）
POS_IMAGE_DIR=/opt/supermarket/AiBaoPOS/Img/ItemImage
POS_EXPORT_JSON=/opt/supermarket/AiBaoPOS/export/POS_Item.json

# --- 管理后台 wxapp-admin（Vite 构建）---
VITE_API_BASE=/api
VITE_FILE_BASE=https://api.your-domain.com
VITE_API_TIMEOUT=15000
VITE_USE_MOCK=false
VITE_LOG_LEVEL=warn
VITE_LOG_CONSOLE=false
VITE_LOG_REPORT=true
VITE_LOG_REPORT_INTERVAL=30000

# --- 小程序 wxapp-frontend（uni build）---
VITE_API_BASE=https://api.your-domain.com/api

# --- 商家 Android App 默认 API ---
MERCHANT_API_BASE=https://api.your-domain.com/api
