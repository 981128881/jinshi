# ============================================================
# 商超项目 · 阿里云生产环境（唯一配置源）
# 部署前：把 cr20.help 改成你的备案域名，并修改所有 CHANGE_ME
# 一键写入各项目：node deploy/apply-production-env.mjs --domain=你的域名.com
# ============================================================

# --- 域名（必须修改）---
PRODUCTION_DOMAIN=cr20.help

# 子域名约定（需 DNS 解析 + ICP 备案 + SSL）
# API:   https://api.cr20.help
# 管理:  https://admin.cr20.help

# --- 后端 wxapp-backend ---
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://api.cr20.help
CORS_ORIGINS=https://admin.cr20.help,https://api.cr20.help
MERCHANT_SEED_PASSWORD=CHANGE_ME_MERCHANT_SEED_PASSWORD

JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

DATABASE_URL=mysql://wxapp:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/wxapp_shop?connection_limit=10&pool_timeout=20
REDIS_URL=redis://127.0.0.1:6379

REQUEST_TIMEOUT_MS=30000
LOG_DIR=./logs
LOG_LEVEL=info
LOG_TO_CONSOLE=false
LOG_MAX_FILE_MB=50
DB_LOG_QUERY=false
DB_SLOW_QUERY_MS=1000
REDIS_LOG_CACHE=false
CLIENT_LOG_ENABLED=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_ACCESS_EXPIRES_IN=2h
ADMIN_REFRESH_EXPIRES_IN=7d

POS_SYNC_TOKEN=CHANGE_ME_POS_SYNC_TOKEN

# 微信小程序（上线必填）
WX_APPID=wxc6a5e1d4f0f981de
WX_SECRET=
WX_SUBSCRIBE_TMPL_ORDER=HKCRZh-jslxB-ODzrZd-L2AKrZakzhlCEqcgg5I-lP400
WX_SUBSCRIBE_TMPL_CANCEL=Q4GuBW3YcoZne4ovHT4b4NIn-u2XHqh-oDp_CHcSPSS

# 微信支付（开通后填写）
WX_MCH_ID=
WX_API_V3_KEY=
WX_CERT_SERIAL_NO=
WX_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_MERCHANT_CERT_PATH=./certs/apiclient_cert.pem
WX_PAY_NOTIFY_URL=https://api.cr20.help/api/pay/notify
WX_PAY_MOCK=false
ORDER_PAY_TIMEOUT_MINUTES=15

# 可选
APIZERO_API_KEY=
JISU_API_KEY=
TENCENT_MAP_KEY=

# 服务器上 POS 图片路径（若 POS 不同步到云，可留空）
POS_IMAGE_DIR=/opt/supermarket/AiBaoPOS/Img/ItemImage
POS_EXPORT_JSON=/opt/supermarket/AiBaoPOS/export/POS_Item.json

# --- 管理后台 wxapp-admin（Vite 构建）---
VITE_API_BASE=https://api.cr20.help/api
VITE_FILE_BASE=https://api.cr20.help
VITE_API_TIMEOUT=15000
VITE_USE_MOCK=false
VITE_LOG_LEVEL=warn
VITE_LOG_CONSOLE=false
VITE_LOG_REPORT=true
VITE_LOG_REPORT_INTERVAL=30000

# --- 小程序 wxapp-frontend（uni build）---
VITE_API_BASE=https://api.cr20.help/api
