# 开发: cp .env.example .env.development
# 生产: 修改 .env.production 或运行 deploy/apply-production-env.mjs

VITE_API_BASE=/api
VITE_FILE_BASE=http://localhost:3000
VITE_API_TIMEOUT=15000
VITE_USE_MOCK=false
VITE_LOG_LEVEL=debug
VITE_LOG_CONSOLE=true
VITE_LOG_REPORT=true
VITE_LOG_REPORT_INTERVAL=30000

# 高德 Web 端 Key（餐厅选点）；控制台开「Web端(JS API)」
# VITE_AMAP_KEY=
# VITE_AMAP_SECURITY_CODE=
