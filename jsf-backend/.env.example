# 复制为 .env 后修改

PORT=3000
JWT_SECRET=HqK9C6L8lF/EiaQCeBE5Ifaha0CpABdkai4T+kYidFau8dzFa60meowffSEvDs/P8WCAZzXdO3xlHzWeWsaKFg==
JWT_EXPIRES_IN=7d

# MySQL（与 docker-compose.yml 默认一致，端口 3307 避免与商超 3306 冲突）
