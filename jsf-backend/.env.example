# 复制为 .env 后修改

PORT=3000
# 本地联调小程序时用本机/局域网，例如 http://192.168.x.x:3000；上线用 https://api.cr20.help
PUBLIC_BASE_URL=http://localhost:3000
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# MySQL（与 docker-compose.yml 默认一致，端口 3307 避免与商超 3306 冲突）
DATABASE_URL="mysql://wxapp:wxapp123456@localhost:3307/jinshifang"

# Redis（端口 6380，避免与商超 6379 冲突）
REDIS_URL=redis://localhost:6380

# 管理后台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_ACCESS_EXPIRES_IN=2h
ADMIN_REFRESH_EXPIRES_IN=7d
# 种子商家后台密码（不要再用电话当密码）。已入库账号需重跑 seed-merchants
MERCHANT_SEED_PASSWORD=ChangeMe_jsf
# 生产填管理后台域名，逗号分隔。不填时开发放行、生产只允许 PUBLIC_BASE_URL 及其 admin 子域
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# AiBao POS 同步（与 sync/config.yaml 中 api.token 一致）
POS_SYNC_TOKEN=change-me-pos-sync-token

# 淘宝开放平台（条码查主图，见 docs/PRODUCT_ENRICHMENT.md）
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION=

# 国内条码 API（无需淘宝，见 docs/PRODUCT_ENRICHMENT.md）
APIZERO_API_KEY=
JISU_API_KEY=

# POS 本地图片目录（爱宝收银 ItemImage）
POS_IMAGE_DIR=G:/supermarket/AiBaoPOS/ABPOSYun/Img/ItemImage
POS_EXPORT_JSON=G:/supermarket/AiBaoPOS/export/POS_Item.json

# 微信小程序（必须与 jsf-frontend/manifest.json → mp-weixin.appid 一致）
WX_APPID=wxc6a5e1d4f0f981de
WX_SECRET=
# 店铺码版本：release / trial / develop（体验版扫码改 trial 并删缓存 png）
WX_WXA_ENV=release
# 订阅消息：公众平台模板ID。关键词须按顺序：商品名称、下单时间、订单金额、订单编号
# WX_SUBSCRIBE_TMPL_ORDER=
# WX_SUBSCRIBE_TMPL_CANCEL=

# 微信支付 APIv3（上线后填写，密钥勿提交代码库）
WX_MCH_ID=
WX_API_V3_KEY=
WX_CERT_SERIAL_NO=
WX_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WX_MERCHANT_CERT_PATH=./certs/apiclient_cert.pem
WX_PAY_NOTIFY_URL=https://api.cr20.help/api/pay/notify
WX_PAY_MOCK=false
ORDER_PAY_TIMEOUT_MINUTES=15

# 生产环境见 .env.production 与 deploy/production.env
# 一键生成: node deploy/apply-production-env.mjs --domain=你的域名.com
